[
  {
    "name": "hexstrike-crypto",
    "transport": "stdio",
    "command": "docker",
    "args": [
      "compose",
      "-f",
      "compose.hexstrike.yml",
      "exec",
      "-T",
      "hexstrike",
      "python3",
      "-m",
      "ctf_adapter.mcp_server",
      "--profile",
      "crypto"
    ],
    "allowed_tools": [
      "tool_inventory",
      "file_identify",
      "strings_extract",
      "sage_execute",
      "rsa_ctf_analyze",
      "crypto_python_run",
      "hashcat_crack",
      "john_crack",
      "xor_analyze",
      "hashpump_attack",
      "bkcrack_attack",
      "openssl_inspect"
    ],
    "notes": "OmniCTF crypto profile. The adapter registers only this reviewed profile and validates workbench paths and engagement scope."
  }
]
