{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "hexstrike": {
      "type": "local",
      "command": ["./scripts/hexstrike-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "hexstrike_lab": {
      "type": "local",
      "command": ["./scripts/hexstrike-lab-mcp"],
      "enabled": false,
      "timeout": 30000
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "penetration-testing-with-strix": "allow",
      "mobile-*": "allow",
      "ctf-*": "allow",
      "ctf-pwn": "ask",
      "ctf-malware": "ask",
      "cicd-*": "ask",
      "github-actions-*": "ask",
      "pwn-request": "ask",
      "self-hosted-runner-poisoning": "ask"
    },
    "hexstrike_*": "ask",
    "hexstrike_lab_*": "ask",
    "hexstrike_ai_*": "deny",
    "hexstrike_bugbounty_*": "deny",
    "hexstrike_execute_command": "deny",
    "hexstrike_execute_python_script": "deny",
    "hexstrike_install_python_package": "deny",
    "hexstrike_create_file": "deny",
    "hexstrike_modify_file": "deny",
    "hexstrike_delete_file": "deny",
    "hexstrike_advanced_payload_generation": "deny",
    "hexstrike_create_attack_chain_ai": "deny",
    "hexstrike_detect_technologies_ai": "deny",
    "hexstrike_discover_attack_chains": "deny",
    "hexstrike_generate_exploit_from_cve": "deny",
    "hexstrike_intelligent_smart_scan": "deny",
    "hexstrike_optimize_tool_parameters_ai": "deny",
    "hexstrike_research_zero_day_opportunities": "deny",
    "hexstrike_select_optimal_tools_ai": "deny"
  }
}
