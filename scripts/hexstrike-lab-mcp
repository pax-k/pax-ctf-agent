#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose_file="$repo_dir/extras/hexstrike-lab/compose.yml"

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  printf '%s\n' 'Docker Compose v2 is required for the optional lab MCP' >&2
  exit 1
fi

exec docker compose -f "$compose_file" exec -T hexstrike python3 -m lab_adapter.mcp_server --profile lab
