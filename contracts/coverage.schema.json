{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnictf.local/schemas/coverage.schema.json",
  "title": "OmniCTF coverage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": {"const": 1},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "subdomain", "owner", "installedTool", "mcpTool", "profile", "skill", "architectures", "fixture", "smokeTest", "license", "evidenceOwner", "validationLevel"],
        "properties": {
          "category": {"enum": ["reverse", "web", "forensics", "pwn", "crypto", "osint", "blockchain", "misc", "koth"]},
          "subdomain": {"type": "string", "minLength": 1},
          "owner": {"enum": ["strix", "opencode", "hexstrike"]},
          "installedTool": {"type": ["string", "null"]},
          "mcpTool": {"type": ["string", "null"]},
          "profile": {"type": ["string", "null"]},
          "skill": {"type": "string", "minLength": 1},
          "architectures": {"type": "array", "minItems": 1, "items": {"enum": ["amd64", "arm64", "platform-independent"]}},
          "fixture": {"type": "string", "minLength": 1},
          "smokeTest": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "evidenceOwner": {"enum": ["strix", "opencode", "hexstrike"]},
          "validationLevel": {"enum": ["static", "smoke", "fixture", "live"]}
        }
      }
    }
  }
}
