{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnictf.local/schemas/scope.schema.json",
  "title": "OmniCTF engagement scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engagementId",
    "mode",
    "startsAt",
    "endsAt",
    "targets",
    "osintSources",
    "categories",
    "prohibitedActions",
    "koth",
    "evidenceLevel"
  ],
  "properties": {
    "engagementId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "mode": {"const": "mode-1-opencode-orchestrates"},
    "startsAt": {"type": "string", "format": "date-time"},
    "endsAt": {"type": "string", "format": "date-time"},
    "targets": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "osintSources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["reverse", "web", "forensics", "pwn", "crypto", "osint", "blockchain", "misc", "koth"]}
    },
    "accounts": {"type": "array", "items": {"type": "string"}},
    "teamIdentity": {"type": "string"},
    "prohibitedActions": {"type": "array", "items": {"type": "string"}},
    "koth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPatchApplication", "allowFlagSubmission"],
      "properties": {
        "allowPatchApplication": {"type": "boolean"},
        "allowFlagSubmission": {"type": "boolean"},
        "submissionEndpoints": {"type": "array", "items": {"type": "string", "format": "uri"}}
      }
    },
    "evidenceLevel": {"enum": ["workshop", "competition", "formal"]}
  }
}
